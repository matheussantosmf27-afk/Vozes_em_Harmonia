# Copie para .env.local e preencha.
# URL e chave PUBLICÁVEL (ou "anon") do seu projeto Supabase.
# Nunca coloque a chave de serviço (service_role/secret) aqui: o app não precisa dela.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
# Endereço público do site (links de confirmação de e-mail). No Vercel pode ser omitido.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
